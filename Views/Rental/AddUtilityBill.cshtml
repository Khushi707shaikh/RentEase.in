@model RentEase.DTOs.UtilityBillDTO

@{
    ViewData["Title"] = "Add Utility Bill";
}

<div class="container mt-4">

    <h2>Add Utility Bill</h2>
    <p>Record electricity, water and other utility expenses.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <form asp-action="AddUtilityBill" method="post">

        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Rental Agreement</label>
            <select asp-for="AgreementId"
                    asp-items="ViewBag.Agreements"
                    class="form-select">
                <option value="">Select Agreement</option>
            </select>
            <span asp-validation-for="AgreementId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="BillType" class="form-label">
                Utility Type
            </label>
            <select asp-for="BillType" class="form-select">
                <option value="">Select Utility</option>
                <option value="Electricity">Electricity</option>
                <option value="Water">Water</option>
                <option value="Gas">Gas</option>
                <option value="Internet">Internet</option>
                <option value="Other">Other</option>
            </select>
            <span asp-validation-for="BillType"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Amount" class="form-label">
                Amount (₹)
            </label>
            <input asp-for="Amount"
                   class="form-control"
                   type="number"
                   step="0.01" />
            <span asp-validation-for="Amount"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="BillingDate" class="form-label">
                Billing Date
            </label>
            <input asp-for="BillingDate"
                   type="date"
                   class="form-control" />
            <span asp-validation-for="BillingDate"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DueDate" class="form-label">
                Due Date
            </label>
            <input asp-for="DueDate"
                   type="date"
                   class="form-control" />
            <span asp-validation-for="DueDate"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Utility Bill
        </button>

        <a asp-action="TenantDashboard"
           class="btn btn-secondary">
            Back
        </a>

    </form>
</div>