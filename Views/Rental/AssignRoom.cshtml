@model RentEase.DTOs.AssignRoomDTO

@{
    ViewData["Title"] = "Assign Room";
}

<div class="container mt-4">

    <div class="card shadow-sm mx-auto" style="max-width: 650px;">

        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Assign Tenant to Room</h4>
        </div>

        <div class="card-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <form asp-action="AssignRoom" method="post">

                <div class="mb-3">
                    <label asp-for="TenantId" class="form-label">
                        Select Tenant
                    </label>

                    <select asp-for="TenantId"
                            asp-items="ViewBag.Tenants"
                            class="form-select">
                        <option value="">-- Select Tenant --</option>
                    </select>

                    <span asp-validation-for="TenantId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RoomId" class="form-label">
                        Select Available Room
                    </label>

                    <select asp-for="RoomId"
                            asp-items="ViewBag.Rooms"
                            class="form-select">
                        <option value="">-- Select Room --</option>
                    </select>

                    <span asp-validation-for="RoomId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MoveInDate" class="form-label">
                        Move-in Date
                    </label>

                    <input asp-for="MoveInDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="MoveInDate"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EndDate" class="form-label">
                        Agreement End Date
                    </label>

                    <input asp-for="EndDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="EndDate"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MonthlyRent" class="form-label">
                        Monthly Rent (₹)
                    </label>

                    <input asp-for="MonthlyRent"
                           type="number"
                           step="0.01"
                           class="form-control" />

                    <span asp-validation-for="MonthlyRent"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SecurityDeposit" class="form-label">
                        Security Deposit (₹)
                    </label>

                    <input asp-for="SecurityDeposit"
                           type="number"
                           step="0.01"
                           class="form-control" />

                    <span asp-validation-for="SecurityDeposit"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success w-100">
                    Assign Room
                </button>

                <a asp-controller="Property"
                   asp-action="Index"
                   class="btn btn-secondary w-100 mt-2">
                    Cancel
                </a>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
