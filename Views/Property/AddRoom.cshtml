@model RentEase.DTOs.RoomDTO

@{
    ViewData["Title"] = "Add Room";
}

<div class="container mt-4">

    <h2>Add Room</h2>

    <form asp-action="AddRoom" method="post">

        <input type="hidden" asp-for="PropertyId" />

        <div class="mb-3">
            <label asp-for="RoomNumber" class="form-label"></label>
            <input asp-for="RoomNumber" class="form-control"
                   placeholder="Example: R1 or Shop-1" />
            <span asp-validation-for="RoomNumber"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MonthlyRent" class="form-label"></label>
            <input asp-for="MonthlyRent" type="number" step="0.01"
                   class="form-control" />
            <span asp-validation-for="MonthlyRent"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Capacity" class="form-label"></label>
            <input asp-for="Capacity" type="number"
                   class="form-control" />
            <span asp-validation-for="Capacity"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RoomType" class="form-label"></label>
            <select asp-for="RoomType" class="form-select">
                <option value="">Select Type</option>
                <option value="Residential">Residential</option>
                <option value="Commercial">Commercial</option>
            </select>
            <span asp-validation-for="RoomType"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                <option value="Available">Available</option>
                <option value="Occupied">Occupied</option>
                <option value="Maintenance">Maintenance</option>
            </select>
        </div>

        <button type="submit" class="btn btn-success">
            Save Room
        </button>

        <a asp-action="Rooms"
           asp-route-propertyId="@Model.PropertyId"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
