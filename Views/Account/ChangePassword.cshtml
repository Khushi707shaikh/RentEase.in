@model RentEase.DTOs.ChangePasswordDTO

@{
    ViewData["Title"] = "Change Password";
}

<div class="re-page">

    <div class="re-page-heading">
        <div>
            <span class="re-eyebrow">ACCOUNT SECURITY</span>
            <h2>Change Password</h2>
            <p>Update your password to keep your RentEase account secure.</p>
        </div>
        <div class="re-heading-icon">⚿</div>
    </div>

    <div class="re-password-layout">

        <div class="re-password-info">
            <div class="re-security-icon">♙</div>
            <h3>Protect your account</h3>
            <p>
                Use a strong password that is difficult for others to guess.
                Avoid sharing your password with anyone.
            </p>

            <div class="re-security-tip">
                <span>✓</span>
                Use at least 8 characters
            </div>
            <div class="re-security-tip">
                <span>✓</span>
                Include uppercase and lowercase letters
            </div>
            <div class="re-security-tip">
                <span>✓</span>
                Include a number or special character
            </div>
        </div>

        <div class="re-password-form-card">
            <h4>Set a New Password</h4>
            <p class="re-form-description">Enter your new password below.</p>

            <form asp-controller="Account"
                  asp-action="ChangePassword"
                  method="post"
                  id="changePasswordForm">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger re-validation-summary"></div>

                <div class="re-form-group">
                    <label asp-for="NewPassword">New Password</label>
                    <div class="re-password-input">
                        <input asp-for="NewPassword"
                               type="password"
                               id="newPassword"
                               class="form-control"
                               placeholder="Enter new password"
                               autocomplete="new-password" />
                        <button type="button"
                                class="re-toggle-password"
                                data-target="newPassword"
                                aria-label="Show password">
                            Show
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword"
                          class="text-danger"></span>

                    <div class="re-strength-track">
                        <div id="passwordStrengthBar"></div>
                    </div>
                    <small id="passwordStrengthText" class="re-strength-text">
                        Password strength
                    </small>
                </div>

                <div class="re-form-group">
                    <label asp-for="ConfirmPassword">Confirm New Password</label>
                    <div class="re-password-input">
                        <input asp-for="ConfirmPassword"
                               type="password"
                               id="confirmPassword"
                               class="form-control"
                               placeholder="Re-enter new password"
                               autocomplete="new-password" />
                        <button type="button"
                                class="re-toggle-password"
                                data-target="confirmPassword"
                                aria-label="Show password">
                            Show
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger"></span>
                    <small id="passwordMatchMessage"></small>
                </div>

                <button type="submit" class="re-submit-btn">
                    Update Password <span>→</span>
                </button>

                <a asp-controller="Rental"
                   asp-action="TenantDashboard"
                   class="re-cancel-link">Back to Dashboard</a>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
